# Groq (server-side only; never put this in the frontend)
GROQ_API_KEY=your_groq_api_key_here
# Vision model for OCR and text model for extraction / medical review.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TEXT_MODEL=qwen/qwen3.8-27b
GROQ_MAX_RETRIES=3
GROQ_TIMEOUT_SECONDS=90

# Comma-separated browser origins allowed to call the API.
# *.vercel.app is also allowed by default; override with FRONTEND_ORIGIN_REGEX.
FRONTEND_ORIGIN=http://localhost:3000

# Secret that reviewers type into the UI to approve/reject MANUAL_REVIEW claims.
# Leave empty to disable reviewer actions.
REVIEWER_TOKEN=change-me

# Where the SQLite claim store lives (default: backend/data/runtime).
# DATA_DIR=/var/data
RATE_LIMIT_PER_10_MIN=20
